 {
  "id": "f_cfg",
  "type": "function",
  "z": "tab1",
  "name": "CONFIGURAÇÃO",
  "func": "// >>> EDITE AQUI <<<\nflow.set('cfg', {\n  chTelemetry: '0000000',      // ID do canal de telemetria (ThingSpeak)\n  readKey: '',                 // Read API Key do canal de telemetria (vazio se o canal for público)\n  chCommands: '0000000',       // ID do canal de comandos\n  writeKeyCommands: 'COLE_A_WRITE_API_KEY_DO_CANAL_DE_COMANDOS'\n});\nreturn null;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 60,
  "wires": [
   []
  ]
 },
