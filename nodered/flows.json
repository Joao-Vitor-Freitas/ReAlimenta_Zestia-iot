 {
  "id": "f_split",
  "type": "function",
  "z": "tab1",
  "name": "Separar campos",
  "func": "const f = msg.payload;\nif (!f || !f.created_at) return [null, null, null, null, null, { payload: 'SEM DADOS' }];\nconst n = v => (v === null || v === undefined || v === '') ? null : Number(v);\nconst age = Math.round((Date.now() - Date.parse(f.created_at)) / 1000);\nconst estados = ['NORMAL', 'ATENÇÃO', 'CRÍTICO', 'FALHA NO SENSOR'];\nconst modos = ['AUTOMÁTICO', 'LIGADO (manual)', 'DESLIGADO (manual)'];\nreturn [\n  { payload: n(f.field1) },\n  { payload: n(f.field2) },\n  { payload: n(f.field3) === 1 ? 'LIGADO' : 'DESLIGADO' },\n  { payload: estados[n(f.field6)] || '—' },\n  { payload: `${n(f.field4)} °C · ${modos[n(f.field5)] || '—'}` },\n  { payload: age > 60 ? `OFFLINE (sem dados há ${age}s)` : `ONLINE (último dado há ${age}s)` }\n];",
  "outputs": 6,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 760,
  "y": 140,
  "wires": [
