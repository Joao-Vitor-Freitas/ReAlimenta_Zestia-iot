 {
  "id": "f_read",
  "type": "function",
  "z": "tab1",
  "name": "URL de leitura",
  "func": "const c = flow.get('cfg'); if (!c) return null;\nmsg.url = `https://api.thingspeak.com/channels/${c.chTelemetry}/feeds/last.json` + (c.readKey ? `?api_key=${c.readKey}` : '');\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 360,
